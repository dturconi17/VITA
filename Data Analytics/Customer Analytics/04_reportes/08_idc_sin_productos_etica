/*==============================================================
ANÁLISIS 1
COMPARACIÓN POR COHORTE ANUAL
==============================================================*/

WITH ResumenCohorte AS
(
    SELECT
        [cohorte_año],

        CASE
            WHEN cliente_etica = 1
                THEN 'CLIENTE ETICA'
            ELSE 'CLIENTE NO ETICA'
        END AS grupo_cliente,

        COUNT(*) AS clientes,

        AVG
        (
            CAST(antiguedad_meses AS DECIMAL(19,4))
        ) AS antiguedad_promedio,

        AVG
        (
            CAST(meses_activos_historicos AS DECIMAL(19,4))
        ) AS meses_activos_promedio,

        AVG
        (
            CAST(venta_historica AS DECIMAL(19,4))
        ) AS venta_historica_promedio,

        AVG
        (
            CAST(venta_no_etica_historica AS DECIMAL(19,4))
        ) AS venta_no_etica_promedio,

        AVG
        (
            CAST(venta_mensual_promedio_historica AS DECIMAL(19,4))
        ) AS venta_mensual_promedio,

        AVG
        (
            CAST(facturas_historicas AS DECIMAL(19,4))
        ) AS facturas_promedio,

        AVG
        (
            CAST(frecuencia_historica AS DECIMAL(19,4))
        ) AS frecuencia_promedio,

        AVG
        (
            CAST(productos_historicos AS DECIMAL(19,4))
        ) AS productos_promedio,

        AVG
        (
            CAST(productos_no_etica_historicos AS DECIMAL(19,4))
        ) AS productos_no_etica_promedio,

        AVG
        (
            CAST(lineas_historicas AS DECIMAL(19,4))
        ) AS lineas_promedio

    FROM sales.ca_cliente

    WHERE facturas_historicas > 0
      AND [cohorte_año] IS NOT NULL

    GROUP BY
        [cohorte_año],

        CASE
            WHEN cliente_etica = 1
                THEN 'CLIENTE ETICA'
            ELSE 'CLIENTE NO ETICA'
        END
)

SELECT
    [cohorte_año],
    grupo_cliente,
    clientes,

    CAST(antiguedad_promedio AS DECIMAL(19,2))
        AS antiguedad_promedio,

    CAST(meses_activos_promedio AS DECIMAL(19,2))
        AS meses_activos_promedio,

    CAST(venta_historica_promedio AS DECIMAL(19,4))
        AS venta_historica_promedio,

    CAST(venta_no_etica_promedio AS DECIMAL(19,4))
        AS venta_no_etica_promedio,

    CAST(venta_mensual_promedio AS DECIMAL(19,4))
        AS venta_mensual_promedio,

    CAST(facturas_promedio AS DECIMAL(19,2))
        AS facturas_promedio,

    CAST(frecuencia_promedio AS DECIMAL(19,4))
        AS frecuencia_promedio,

    CAST(productos_promedio AS DECIMAL(19,2))
        AS productos_promedio,

    CAST(productos_no_etica_promedio AS DECIMAL(19,2))
        AS productos_no_etica_promedio,

    CAST(lineas_promedio AS DECIMAL(19,2))
        AS lineas_promedio

FROM ResumenCohorte

ORDER BY
    [cohorte_año],
    grupo_cliente;


/*==============================================================
IRV POR COHORTE ANUAL
==============================================================*/

WITH Resumen AS
(
    SELECT
        [cohorte_año],
        cliente_etica,

        COUNT(*) AS clientes,

        AVG
        (
            CAST(venta_no_etica_historica AS DECIMAL(19,4))
        ) AS venta_no_etica,

        AVG
        (
            CAST(venta_mensual_promedio_historica AS DECIMAL(19,4))
        ) AS venta_mensual,

        AVG
        (
            CAST(frecuencia_historica AS DECIMAL(19,4))
        ) AS frecuencia,

        AVG
        (
            CAST(productos_no_etica_historicos AS DECIMAL(19,4))
        ) AS productos_no_etica,

        AVG
        (
            CAST(meses_activos_historicos AS DECIMAL(19,4))
        ) AS meses_activos,

        AVG
        (
            CAST(lineas_historicas AS DECIMAL(19,4))
        ) AS lineas

    FROM sales.ca_cliente

    WHERE facturas_historicas > 0
      AND [cohorte_año] IS NOT NULL

    GROUP BY
        [cohorte_año],
        cliente_etica
),
Pivotado AS
(
    SELECT
        [cohorte_año],

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN clientes
            END
        ) AS clientes_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN clientes
            END
        ) AS clientes_no_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN venta_no_etica
            END
        ) AS venta_no_etica_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN venta_no_etica
            END
        ) AS venta_no_etica_no_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN venta_mensual
            END
        ) AS venta_mensual_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN venta_mensual
            END
        ) AS venta_mensual_no_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN frecuencia
            END
        ) AS frecuencia_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN frecuencia
            END
        ) AS frecuencia_no_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN productos_no_etica
            END
        ) AS productos_no_etica_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN productos_no_etica
            END
        ) AS productos_no_etica_no_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN meses_activos
            END
        ) AS meses_activos_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN meses_activos
            END
        ) AS meses_activos_no_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 1
                THEN lineas
            END
        ) AS lineas_etica,

        MAX
        (
            CASE
                WHEN cliente_etica = 0
                THEN lineas
            END
        ) AS lineas_no_etica

    FROM Resumen

    GROUP BY
        [cohorte_año]
)

SELECT
    [cohorte_año],
    clientes_etica,
    clientes_no_etica,

    CAST
    (
        venta_no_etica_etica
        / NULLIF(venta_no_etica_no_etica, 0)
        AS DECIMAL(19,4)
    ) AS irv_venta_no_etica,

    CAST
    (
        venta_mensual_etica
        / NULLIF(venta_mensual_no_etica, 0)
        AS DECIMAL(19,4)
    ) AS irv_venta_mensual,

    CAST
    (
        frecuencia_etica
        / NULLIF(frecuencia_no_etica, 0)
        AS DECIMAL(19,4)
    ) AS irv_frecuencia,

    CAST
    (
        productos_no_etica_etica
        / NULLIF(productos_no_etica_no_etica, 0)
        AS DECIMAL(19,4)
    ) AS irv_productos_no_etica,

    CAST
    (
        meses_activos_etica
        / NULLIF(meses_activos_no_etica, 0)
        AS DECIMAL(19,4)
    ) AS irv_meses_activos,

    CAST
    (
        lineas_etica
        / NULLIF(lineas_no_etica, 0)
        AS DECIMAL(19,4)
    ) AS irv_lineas

FROM Pivotado

WHERE clientes_etica >= 30
  AND clientes_no_etica >= 30

ORDER BY
    [cohorte_año];