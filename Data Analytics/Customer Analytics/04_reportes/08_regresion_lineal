/*==============================================================
ANÁLISIS 4
DATASET PARA MODELOS ESTADÍSTICOS
==============================================================*/

SELECT
    CAST(cliente_etica AS INT) AS cliente_etica,

    canal,
    cohorte_año,
    antiguedad_meses,

    venta_historica,
    LOG10(1 + venta_historica) AS log_venta_historica,

    productos_no_etica_historicos,
    lineas_historicas,
    frecuencia_historica,
    meses_activos_historicos,
    venta_mensual_promedio_historica

FROM sales.ca_cliente

WHERE facturas_historicas > 0
  AND venta_historica IS NOT NULL
  AND antiguedad_meses IS NOT NULL
  AND cohorte_año IS NOT NULL;