/*==============================================================
IRV POR COHORTE
==============================================================*/

WITH Resumen AS
(
    SELECT
        cohorte_año,

        cliente_etica,

        COUNT(*) AS clientes,

        AVG(CAST(venta_no_etica_historica AS DECIMAL(19,4)))
            AS venta_no_etica,

        AVG(CAST(venta_mensual_promedio_historica AS DECIMAL(19,4)))
            AS venta_mensual,

        AVG(CAST(frecuencia_historica AS DECIMAL(19,4)))
            AS frecuencia,

        AVG(CAST(productos_no_etica_historicos AS DECIMAL(19,4)))
            AS productos_no_etica,

        AVG(CAST(meses_activos_historicos AS DECIMAL(19,4)))
            AS meses_activos,

        AVG(CAST(idc_sin_productos_etica AS DECIMAL(19,4)))
            AS idc

    FROM sales.ca_cliente

    WHERE cohorte_año IS NOT NULL

    GROUP BY
        cohorte_año,
        cliente_etica
),
Pivotado AS
(
    SELECT
        cohorte_año,

        MAX(CASE WHEN cliente_etica = 1 THEN clientes END)
            AS clientes_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN clientes END)
            AS clientes_no_etica,

        MAX(CASE WHEN cliente_etica = 1 THEN venta_no_etica END)
            AS venta_no_etica_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN venta_no_etica END)
            AS venta_no_etica_no_etica,

        MAX(CASE WHEN cliente_etica = 1 THEN venta_mensual END)
            AS venta_mensual_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN venta_mensual END)
            AS venta_mensual_no_etica,

        MAX(CASE WHEN cliente_etica = 1 THEN frecuencia END)
            AS frecuencia_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN frecuencia END)
            AS frecuencia_no_etica,

        MAX(CASE WHEN cliente_etica = 1 THEN productos_no_etica END)
            AS productos_no_etica_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN productos_no_etica END)
            AS productos_no_etica_no_etica,

        MAX(CASE WHEN cliente_etica = 1 THEN meses_activos END)
            AS meses_activos_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN meses_activos END)
            AS meses_activos_no_etica,

        MAX(CASE WHEN cliente_etica = 1 THEN idc END)
            AS idc_etica,

        MAX(CASE WHEN cliente_etica = 0 THEN idc END)
            AS idc_no_etica

    FROM Resumen

    GROUP BY cohorte_año
)

SELECT
    cohorte_año,
    clientes_etica,
    clientes_no_etica,

    CAST
    (
        venta_no_etica_etica
        / NULLIF(venta_no_etica_no_etica, 0)
        AS DECIMAL(19,2)
    ) AS irv_venta_no_etica,

    CAST
    (
        venta_mensual_etica
        / NULLIF(venta_mensual_no_etica, 0)
        AS DECIMAL(19,2)
    ) AS irv_venta_mensual,

    CAST
    (
        frecuencia_etica
        / NULLIF(frecuencia_no_etica, 0)
        AS DECIMAL(19,2)
    ) AS irv_frecuencia,

    CAST
    (
        productos_no_etica_etica
        / NULLIF(productos_no_etica_no_etica, 0)
        AS DECIMAL(19,2)
    ) AS irv_productos_no_etica,

    CAST
    (
        meses_activos_etica
        / NULLIF(meses_activos_no_etica, 0)
        AS DECIMAL(19,2)
    ) AS irv_meses_activos,

    CAST
    (
        idc_etica
        / NULLIF(idc_no_etica, 0)
        AS DECIMAL(19,2)
    ) AS irv_idc

FROM Pivotado

/* Evita cohortes con muestras demasiado pequeñas */
WHERE clientes_etica >= 30
  AND clientes_no_etica >= 30

ORDER BY cohorte_año;