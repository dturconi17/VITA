/*==============================================================
H2.1.C - VALOR ECONÓMICO DE LA CARTERA ACTUAL

Universo:
Clientes con al menos una compra en los últimos 6 meses.

Métricas:
Comportamiento de los últimos 12 meses.
==============================================================*/

SELECT
    CASE
        WHEN cliente_etica = 1
        THEN 'CARTERA ETICA'
        ELSE 'CARTERA NO ETICA'
    END AS grupo_cliente,

    COUNT(*) AS clientes,

    SUM(venta_12m) AS venta_total_12m,

    CAST
    (
        AVG(venta_12m)
        AS DECIMAL(18,2)
    ) AS venta_promedio_12m_cliente,

    CAST
    (
        AVG(venta_mensual_promedio_12m)
        AS DECIMAL(18,2)
    ) AS venta_mensual_promedio_12m,

    CAST
    (
        AVG(ticket_promedio_12m)
        AS DECIMAL(18,2)
    ) AS ticket_promedio_12m,

    CAST
    (
        AVG(CAST(facturas_12m AS DECIMAL(18,2)))
        AS DECIMAL(18,2)
    ) AS facturas_promedio_12m,

    CAST
    (
        AVG(frecuencia_12m)
        AS DECIMAL(18,2)
    ) AS facturas_por_mes_activo_12m,

    CAST
    (
        AVG(CAST(productos_12m AS DECIMAL(18,2)))
        AS DECIMAL(18,2)
    ) AS productos_promedio_12m,

    CAST
    (
        AVG(CAST(lineas_12m AS DECIMAL(18,2)))
        AS DECIMAL(18,2)
    ) AS lineas_promedio_12m,

    CAST
    (
        AVG(CAST(meses_activos_12m AS DECIMAL(18,2)))
        AS DECIMAL(18,2)
    ) AS meses_activos_promedio_12m

FROM sales.ca_cliente

WHERE cartera_actual = 1

GROUP BY cliente_etica

ORDER BY cliente_etica DESC;