SELECT
    CASE
        WHEN cliente_etica = 1 THEN 'Ética'
        ELSE 'No Ética'
    END AS grupo,
    COUNT(*) AS clientes,
    CAST
    (
        AVG(idc)
        AS DECIMAL(10,2)
    ) AS idc_promedio,
    CAST
    (
        AVG(score_productos)
        AS DECIMAL(10,2)
    ) AS score_productos,
    CAST
    (
        AVG(score_frecuencia)
        AS DECIMAL(10,2)
    ) AS score_frecuencia,
    CAST
    (
        AVG(score_venta_mensual)
        AS DECIMAL(10,2)
    ) AS score_venta_mensual,
    CAST
    (
        AVG(score_meses_activos)
        AS DECIMAL(10,2)
    ) AS score_meses_activos
FROM sales.ca_cliente_idc
GROUP BY cliente_etica
ORDER BY cliente_etica DESC;